NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The canonical origin for links in outbound email (password resets).
# Required in production: deriving it from the request's Host header would let a
# forged header point a reset link — with a valid token — at another domain.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Server-only Supabase secret key (sb_secret_...), used only for account deletion.
# Never prefix this with NEXT_PUBLIC_, commit a real key, or expose it in a browser.
SUPABASE_SECRET_KEY=
